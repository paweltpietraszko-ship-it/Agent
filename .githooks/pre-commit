#!/bin/sh
# Mechanical guard: nothing but bookkeeping files may be committed straight to the default branch.
# (Merges use pre-merge-commit and are not affected; the owner can still use --no-verify.)
# Enable once per clone:  git config core.hooksPath .githooks
branch=$(git symbolic-ref --short -q HEAD)
case "$branch" in
  main|master) ;;
  *) exit 0 ;;
esac
# The very first commit of a brand-new repo has nothing to protect yet.
git rev-parse --verify -q HEAD >/dev/null 2>&1 || exit 0
# NUL-separated names, read line by line with IFS= so trailing spaces survive ("BOARD.md " is not "BOARD.md").
names=$(git diff --cached --name-only -z | tr '\0' '\n')
entries=$(git diff --cached --name-only -z | tr -cd '\0' | wc -c | tr -d ' ')
lines=$(printf '%s\n' "$names" | grep -c '' | tr -d ' ')
bad=""
if [ -n "$names" ]; then
  # A name that itself contains a newline would split into several lines: refuse it outright.
  [ "$entries" -eq "$lines" ] || bad=" (nazwa pliku z nowa linia)"
  while IFS= read -r f; do
    case "$f" in
      BOARD.md|ODLOZONE.md) ;;
      *) bad="$bad [$f]" ;;
    esac
  done <<EOF
$names
EOF
fi
if [ -n "$bad" ]; then
  echo "BLOCKED: commit na '$branch' zabroniony (dozwolone tylko BOARD.md i ODLOZONE.md)." >&2
  echo "Pliki:$bad" >&2
  echo "Utworz branch zadania: git switch -c task/<id>" >&2
  exit 1
fi
exit 0
